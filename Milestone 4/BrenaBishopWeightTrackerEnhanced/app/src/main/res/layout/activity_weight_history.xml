<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="72dp">

        <TextView
            android:id="@+id/textHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight History"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goal Weight: 165 lbs"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textProgressMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress: 8 lbs away from your goal"
            android:layout_marginBottom="18dp" />

        <GridLayout
            android:id="@+id/gridWeightHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="20dp">

            <TextView
                android:text="Date"
                android:textStyle="bold"
                android:padding="8dp" />

            <TextView
                android:text="Weight"
                android:textStyle="bold"
                android:padding="8dp" />

            <TextView
                android:text="Action"
                android:textStyle="bold"
                android:padding="8dp" />

            <TextView
                android:text="03/01/26"
                android:padding="8dp" />

            <TextView
                android:text="180 lbs"
                android:padding="8dp" />

            <Button
                android:id="@+id/buttonDeleteRowOne"
                android:text="Delete"
                android:padding="8dp" />

            <TextView
                android:text="03/02/26"
                android:padding="8dp" />

            <TextView
                android:text="179 lbs"
                android:padding="8dp" />

            <Button
                android:id="@+id/buttonDeleteRowTwo"
                android:text="Delete"
                android:padding="8dp" />

        </GridLayout>

        <Button
            android:id="@+id/buttonAddWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Daily Weight" />

        <Button
            android:id="@+id/buttonSetGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Goal Weight"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/buttonSmsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS Notification Settings"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LOGOUT" />

    </LinearLayout>

</ScrollView>